# Copy this file to ".env" (same folder) and fill it in. Never commit .env.
#
# ── n8n ─────────────────────────────────────────────────────────────
# Encrypts the credentials n8n saves (YouTube). Make it once, keep it forever:
# if it changes, n8n can no longer read the saved credentials and you must reconnect them.
# Generate one in PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
N8N_ENCRYPTION_KEY=

# true = fake publishing (nothing is posted). Good for a first test.
DRY_RUN=false
# In DRY_RUN, make some destinations fail on purpose: platforms (facebook,instagram,tiktok,youtube),
# keys (fb:<pageId>, ig:<igUserId>) or exact labels. Example: DRY_RUN_FAIL=tiktok
DRY_RUN_FAIL=

# ── Meta (Facebook pages + Instagram) ───────────────────────────────
# One never-expiring Page access token per page. The variable NAME is what you
# write in accounts.json → "tokenEnv". Instagram uses the token of the page it is linked to.
FB_TOKEN_PAGE_1=
FB_TOKEN_PAGE_2=

# ── Cloudinary (Instagram needs a public URL for the video) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be https and exactly the same as in TikTok Login Kit → Redirect URI (see README).
TIKTOK_REDIRECT_URI=

# ── Telegram (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
