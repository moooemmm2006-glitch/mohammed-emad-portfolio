# ── Demo Studio ─────────────────────────────────────────────
# Password for /studio (choose a long one).
STUDIO_PASSWORD=
# Random secret (32+ chars) used to sign the login cookie and hash visitors.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Turso / libSQL (the same database you already use is fine: Demo Studio only creates demo_* tables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (logos and photos). Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# The public address demos are shared from (no trailing slash).
# With the portfolio rewrites this is your portfolio domain, e.g. https://mohammed-emad-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: Telegram alerts when a demo is opened.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: client custom domains → their real site, e.g. englishdose.com=english-dose,www.englishdose.com=english-dose
CUSTOM_DOMAINS=
