# ---- Claude (Anthropic) ----
# Without a key the app runs on a built-in mock partner so you can try the whole flow.
ANTHROPIC_API_KEY=
# Fast model: conversation turns, level checker, hints, context summaries
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_CHECK_MODEL=claude-haiku-5-5
# Stronger model: the post-conversation report
ANTHROPIC_REPORT_MODEL=claude-opus-5-5
# Force the mock even if a key is present: LLM_PROVIDER=mock
LLM_PROVIDER=

# ---- Text-to-speech ----
# webspeech (default, in the browser) | openai | elevenlabs
# If the matching key is missing the app silently falls back to webspeech.
TTS_PROVIDER=webspeech
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_A1=nova
OPENAI_TTS_VOICE_A2=echo
OPENAI_TTS_VOICE_B1=shimmer
OPENAI_TTS_VOICE_B2=onyx
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_A1=
ELEVENLABS_VOICE_A2=
ELEVENLABS_VOICE_B1=
ELEVENLABS_VOICE_B2=

# ---- Speech-to-text ----
# webspeech (default, Chrome/Edge) | openai (Whisper; records with MediaRecorder, needs OPENAI_API_KEY)
STT_PROVIDER=webspeech
OPENAI_STT_MODEL=whisper-1

# ---- Storage ----
# SQLite file, created automatically
DATABASE_PATH=./data/german-speaking.db

# Log level-checker violations to the server console (on automatically in development)
LOG_LEVEL_VIOLATIONS=
