# ---- Claude (Anthropic), optional ----
# Conversations happen in Gemini (free for the learner). A key only adds two extras:
# "new reading text" (Lesen) and "free writing" corrections (Schreiben). Without it they are hidden.
ANTHROPIC_API_KEY=
# Reading texts
ANTHROPIC_TEXT_MODEL=claude-haiku-5-5
# Free-writing corrections
ANTHROPIC_CORRECTION_MODEL=claude-opus-5-5

# ---- Text-to-speech ----
# webspeech (default, in the browser) | openai | elevenlabs
# If the matching key is missing the app silently falls back to webspeech.
TTS_PROVIDER=webspeech
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_A1=nova
OPENAI_TTS_VOICE_A2=echo
OPENAI_TTS_VOICE_B1=shimmer
OPENAI_TTS_VOICE_B2=onyx
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_A1=
ELEVENLABS_VOICE_A2=
ELEVENLABS_VOICE_B1=
ELEVENLABS_VOICE_B2=

# ---- Speech-to-text ----
# webspeech (default, Chrome/Edge) | openai (Whisper; records with MediaRecorder, needs OPENAI_API_KEY)
STT_PROVIDER=webspeech
OPENAI_STT_MODEL=whisper-1

# ---- Storage ----
# Local: a SQLite file, created automatically.
DATABASE_PATH=./data/german-speaking.db
# Hosted (Vercel): a Turso/libSQL database. The Turso integration on Vercel sets these for you.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Accounts ----
# Secret that signs the login cookies. REQUIRED on Vercel (at least 16 characters).
# Generate one with:  openssl rand -base64 32
# Changing it logs everybody out.
AUTH_SECRET=
# Usernames (comma-separated) that become admin when they sign up. Needed for the first admin of a new
# production database; without it only the first account of a local development database becomes admin.
ADMIN_USERNAMES=

# ---- Profile photos ----
# Vercel Blob token (added automatically when you connect Blob under Vercel → Storage).
# Without it, the small 256×256 photo is stored in the database instead.
BLOB_READ_WRITE_TOKEN=

# ---- Community voice (optional) ----
# Voice calls work browser to browser with public STUN servers. Only if some people on strict networks
# can't hear each other, add a TURN relay (e.g. from a TURN provider):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
