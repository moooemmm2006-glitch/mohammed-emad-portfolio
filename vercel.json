{
  "headers": [
    {
      "source": "/((?!demo|studio|s/|api/|_next/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(demo|studio|s|api|_next)/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo-studio/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/demo/:path*",
      "destination": "https://me-demo-studio.vercel.app/demo/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://me-demo-studio.vercel.app/s/:path*"
    },
    {
      "source": "/studio",
      "destination": "https://me-demo-studio.vercel.app/studio"
    },
    {
      "source": "/studio/:path*",
      "destination": "https://me-demo-studio.vercel.app/studio/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://me-demo-studio.vercel.app/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://me-demo-studio.vercel.app/_next/:path*"
    }
  ]
}
